              {
                "key": "X-Llave-Socio",
                "value": "{{llave}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{url}}/reservas",
              "host": [
                "{{url}}"
              ],
              "path": [
                "reservas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fecha\": \"{{fecha}}\",\n  \"hora\": \"19:00\",\n  \"personas\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 409', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Personas fuera de rango → 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Llave-Socio",
                "value": "{{llave}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{url}}/reservas",
              "host": [
                "{{url}}"
              ],
              "path": [
                "reservas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fecha\": \"{{fecha}}\",\n  \"hora\": \"19:00\",\n  \"personas\": 9\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}