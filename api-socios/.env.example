# Copia este archivo como .env (en api-socios/) y pon tu contraseña de MySQL.
# El archivo .env NUNCA se sube a GitHub.
# La API se arranca con: php -S localhost:8000 index.php   (en api-socios/)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=

# Socio Hotel Las Brumas
# Llave que el hotel manda en el encabezado X-Llave-Socio (de prueba: la
# misma que usa la colección de Postman).
LLAVE_HOTEL=brumas_8ecdbabf96f4ce05fa99d861b715ed44
# Correo del usuario SOCIO "Hotel Las Brumas" (03_datos_iniciales.sql).
# La API busca su id con este correo.
HOTEL_CORREO=reservas@hotellasbrumas.cr
