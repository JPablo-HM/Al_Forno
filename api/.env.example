# Copia este archivo como .env y pon tus datos reales.
# El archivo .env NUNCA se sube a GitHub.
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contraseña_de_mysql
DB_NAME=al_forno

JWT_SECRET=cambia_esto_por_un_texto_largo_y_secreto
JWT_EXPIRES_IN=30d

TZ_APP=America/Costa_Rica

# ---------------------------------------------------------------------
# Seguridad de la cuenta (HU-01, HU-21, HU-23)
# ---------------------------------------------------------------------
# Llaves de 64 caracteres hexadecimales. Genera cada una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠ Si cambias CLAVE_CIFRADO, ya no se pueden leer las cédulas y teléfonos
#   guardados; si cambias CLAVE_HASH_CEDULA, ya no se detectan las repetidas.
CLAVE_CIFRADO=
CLAVE_HASH_CEDULA=

# Correo que envía el link "¿Eres vos?", el código de 6 dígitos y los avisos.
# CORREO_CONTRASENA es la "contraseña de aplicación" de Google (16 letras):
#   myaccount.google.com/apppasswords (requiere verificación en 2 pasos).
# Si CORREO_CONTRASENA queda vacío, la API funciona en MODO PRUEBA: no envía
# correos y los muestra en la consola.
CORREO_USUARIO=tu_correo@gmail.com
CORREO_CONTRASENA=

# Dirección de la API que se pone en el link del correo. Usa la IP de tu PC
# en el Wi-Fi (ipconfig → "Dirección IPv4"), no "localhost": el link se
# abre desde el celular, que debe estar en el mismo Wi-Fi.
URL_PUBLICA=http://192.168.1.10:3000
